# Hermes gateway as a systemd *user* service (install to ~/.config/systemd/user/).
# Fallback template: bin/install.sh prefers `hermes gateway install`, which writes the
# unit matching the pinned Hermes version, and only uses this file when that is unavailable.
# %h = the service user's home. If HERMES_HOME is not ~/.hermes, install.sh rewrites the paths.
[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.hermes/hermes-agent/.hermes/bin/hermes gateway run
WorkingDirectory=%h/.hermes
Environment="PATH=%h/.hermes/hermes-agent/node_modules/.bin:%h/.hermes/node/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HERMES_HOME=%h/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-%h/.hermes/hermes-agent/.hermes/bin/hermes --run-module gateway.systemd_stop_mark
ExecStopPost=-%h/.hermes/hermes-agent/.hermes/bin/hermes --run-module gateway.cgroup_cleanup
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
