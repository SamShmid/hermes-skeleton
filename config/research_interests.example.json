        "hugging face": 1,
        "release": 0.5,
        "released": 0.5,
        "benchmark": 0.5
      },
      "applies_to": [
        "paper",
        "AI / LLM"
      ]
    },
    {
      "name": "Computer security",
      "description": "vulnerabilities, exploits, malware, supply-chain attacks, LLM security (prompt injection, jailbreaks), crypto",
      "weight": 1.0,
      "keywords": {
        "vulnerability": 1.5,
        "vulnerabilities": 1.5,
        "exploit": 1.5,
        "exploited": 1.5,
        "zero-day": 2.5,
        "0-day": 2.5,
        "cve": 1.5,
