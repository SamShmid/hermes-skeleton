        "Security",
        "AI / LLM"
      ]
    },
    {
      "name": "World & geopolitics",
      "description": "major world news and geopolitics",
      "weight": 1.0,
      "keywords": {
        "war": 1.5,
        "ceasefire": 2,
        "sanctions": 1.5,
        "election": 1.5,
        "nato": 2,
        "china": 1.5,
        "russia": 1.5,
        "ukraine": 1.5,
        "israel": 1.5,
        "iran": 1.5,
        "gaza": 1.5,
        "taiwan": 1.5,
