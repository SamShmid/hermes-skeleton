{
  "version": 1,
  "description": "Example interests for scripts/research_digest.py. Copy to $HERMES_HOME/config/research_interests.json and edit: topic keywords ({keyword: weight}; title hits count double), weights, applies_to (item kinds paper/news and/or news categories; empty = everything), exclude (keywords that cancel a topic for an item), arXiv queries, feeds (base_score, position_bonus for editor-ranked front pages), news quotas per category, and the optional LLM rerank task slot.",
  "owner": "a reader who follows ML/LLM progress, browser fingerprinting / web privacy and computer security",
  "papers_top": 5,
  "news_top": 5,
  "timeout_seconds": 15,
  "recency_half_life_days": 3,
  "llm_rerank": {
    "enabled": true,
    "task": "research_rank",
    "candidates": 20,
    "timeout_seconds": 120
  },
  "topics": [
    {
      "name": "Browser fingerprinting & web privacy",
      "description": "browser/device fingerprinting, web tracking, cookies, anti-tracking, privacy-preserving web tech",
      "weight": 1.5,
      "keywords": {
        "fingerprinting": 3,
        "browser fingerprint": 3,
        "canvas fingerprinting": 3,
        "anti-fingerprinting": 3,
        "web tracking": 2.5,
        "tracker": 1.5,
        "trackers": 1.5,
        "third-party cookies": 2,
        "cookies": 1,
        "privacy sandbox": 2,
        "web privacy": 2.5,
        "browser": 1,
        "tor": 1,
        "deanonymization": 2,
        "de-anonymization": 2,
        "privacy": 1,
        "surveillance": 1,
        "ad tracking": 2
      },
      "exclude": [
        "radio frequency",
        "rf fingerprint",
        "rf fingerprinting",
        "wireless",
        "speaker",
        "model fingerprinting",
        "llm fingerprinting",
        "physical layer"
      ]
    },
    {
      "name": "LLM architecture & efficiency",
      "description": "new model architectures, attention variants, MoE, state-space models, efficiency, quantization, small models, reasoning",
      "weight": 1.3,
      "keywords": {
        "transformer": 1.5,
        "attention": 1,
        "mixture of experts": 2.5,
        "moe": 2,
        "state space": 2,
        "mamba": 2,
        "linear attention": 2.5,
        "sparse attention": 2.5,
        "kv cache": 2,
        "quantization": 2,
        "distillation": 1.5,
        "pruning": 1,
        "long context": 1.5,
        "small language model": 3,
        "small language models": 3,
        "efficient inference": 2,
        "speculative decoding": 2,
        "scaling law": 1.5,
        "scaling laws": 1.5,
        "architecture": 1.5,
        "pretraining": 1,
        "reasoning": 1,
        "test-time compute": 2,
        "recurrent": 1,
        "hybrid": 1,
        "diffusion language model": 2,
        "language model": 1,
        "llm": 1,
        "llms": 1
      },
      "applies_to": [
        "paper",
        "AI / LLM"
      ]
    },
    {
      "name": "Agents & tool calling",
      "description": "LLM agents, tool/function calling, computer/browser-use agents, MCP, agent evaluation",
      "weight": 1.2,
      "keywords": {
        "agent": 1.5,
        "agents": 1.5,
        "agentic": 2,
        "tool use": 2.5,
        "tool calling": 3,
        "tool-calling": 3,
        "function calling": 3,
        "computer use": 2.5,
        "browser agent": 3,
        "web agent": 2.5,
        "mcp": 2,
        "model context protocol": 3,
        "multi-agent": 1.5,
        "coding agent": 2
      },
      "applies_to": [
        "paper",
        "AI / LLM",
        "Security"
      ]
    },
    {
      "name": "Local & open models",
      "description": "open-weight model releases, local inference (llama.cpp, Ollama, vLLM, GGUF), on-device models",
      "weight": 1.1,
      "keywords": {
        "open-weight": 2.5,
        "open weights": 2.5,
        "open-source model": 2,
        "llama": 1.5,
        "qwen": 2,
        "mistral": 1.5,
