  ],
  "negative_keywords": [
    "sponsored",
    "webinar",
    "giveaway",
    "% off",
    "best vpn",
    "deal alert",
    "promo code"
  ],
  "papers": {
    "max_age_days": 7,
    "min_score": 3.5,
    "max_per_topic": 2,
    "arxiv_delay_seconds": 3,
    "arxiv_queries": [
      {
        "name": "LLM architecture",
        "max_results": 150,
        "search_query": "(cat:cs.CL OR cat:cs.LG) AND (ti:transformer OR ti:attention OR ti:\"mixture of experts\" OR ti:\"state space\" OR ti:\"small language\" OR ti:quantization OR ti:efficient OR ti:architecture)"
      },
      {
        "name": "Agents and tool calling",
        "max_results": 100,
        "search_query": "(cat:cs.CL OR cat:cs.AI OR cat:cs.LG) AND (ti:agent OR ti:agents OR ti:agentic OR ti:\"tool use\" OR ti:\"tool calling\" OR ti:\"function calling\")"
      },
      {
        "name": "Fingerprinting and web privacy",
        "max_results": 60,
        "search_query": "abs:fingerprinting OR abs:\"web tracking\" OR abs:\"browser privacy\" OR (cat:cs.CR AND abs:browser)"
      },
      {
        "name": "Security",
        "max_results": 120,
        "search_query": "cat:cs.CR"
      }
    ],
    "huggingface_daily": {
      "enabled": true,
      "limit": 50
    }
  },
  "news": {
    "max_age_hours": 48,
    "min_score": 2,
    "quotas": {
      "Security": 2,
      "AI / LLM": 2,
      "World": 1
    },
